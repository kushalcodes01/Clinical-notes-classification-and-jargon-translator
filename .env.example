# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=clinical-note-summariser-secret-key-replace-in-prod

# LLM Provider Configuration: 'mock' (default, no API key needed) or 'gemini'
LLM_PROVIDER=mock

# Gemini API Key (leave empty when using mock provider)
GEMINI_API_KEY=
